OPENALEX_MAILTO=tu@email.com
# Opcional pero recomendada: sin ella, cada corrida cuenta contra el cupo
# diario ANONIMO que OpenAlex comparte entre todos los que pegan desde el
# mismo rango de IP (en GitHub Actions, compartido con muchisimos otros
# usuarios) - se agota con facilidad. Sacala gratis en
# https://help.openalex.org/api/authentication/
OPENALEX_API_KEY=
ANTHROPIC_API_KEY=sk-ant-...

# Parte E, pipeline de oportunidades. Ver README > Envío por Telegram para
# como conseguir estos dos valores (bot personal via @BotFather).
TELEGRAM_BOT_TOKEN=123456789:ABC-...
TELEGRAM_CHAT_ID=...

# Parte E, pipeline de papers - bot y chat SEPARADOS de los de arriba
# (dos chats distintos, no se mezclan). Se consiguen exactamente igual
# (otro /newbot con @BotFather).
TELEGRAM_BOT_TOKEN_PAPERS=123456789:DEF-...
TELEGRAM_CHAT_ID_PAPERS=...
